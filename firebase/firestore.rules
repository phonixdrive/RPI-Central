rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userID) {
      return signedIn() && request.auth.uid == userID;
    }

    function friendshipDocID(a, b) {
      return a < b ? a + "_" + b : b + "_" + a;
    }

    function areFriends(a, b) {
      return exists(
        /databases/$(database)/documents/friendships/$(friendshipDocID(a, b))
      );
    }

    function isModerator() {
      return signedIn() &&
        "moderator" in request.auth.token &&
        request.auth.token.moderator == true;
    }

    function isValidSelfProfileCreate(userID) {
      return isSelf(userID) &&
        !request.resource.data.keys().hasAny([
          "email",
          "socialBanned",
          "socialMutedUntil"
        ]);
    }

    function isValidSelfProfileUpdate(userID) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSelf(userID) &&
        !changed.hasAny(["socialBanned", "socialMutedUntil"]) &&
        (
          !changed.hasAny(["email"]) ||
          !("email" in request.resource.data)
        );
    }

    function isAcceptedFriendship(friendshipID) {
      let data = request.resource.data;
      let friendRequest = get(
        /databases/$(database)/documents/friendRequests/$(data.acceptedRequestID)
      ).data;
      return data.keys().hasOnly(["members", "createdAt", "acceptedRequestID"]) &&
        data.members is list &&
        data.members.size() == 2 &&
        friendshipID == friendshipDocID(data.members[0], data.members[1]) &&
        friendRequest.status == "accepted" &&
        friendRequest.toUserID == request.auth.uid &&
        friendRequest.fromUserID in data.members &&
        friendRequest.toUserID in data.members;
    }

    function campusChatID() {
      return "campusGroup_all_rpi_students";
    }

    function isDirectMessageBetweenFriends(data) {
      return data.sourceKind == "directMessage" &&
        data.memberIDs is list &&
        data.memberIDs.size() == 2 &&
        request.auth.uid in data.memberIDs &&
        areFriends(data.memberIDs[0], data.memberIDs[1]);
    }

    // A group chat's members must come from the friend group it belongs to.
    function membersBelongToFriendGroup(chatID, memberIDs) {
      let groupPath = /databases/$(database)/documents/friendGroups/$(chatID.replace("^manualGroup_", ""));
      return exists(groupPath) &&
        memberIDs.hasOnly(get(groupPath).data.memberIDs.concat([get(groupPath).data.ownerID]));
    }

    // A class chat's members must be members of that class community.
    function membersBelongToCommunity(chatID, memberIDs) {
      let communityPath = /databases/$(database)/documents/courseCommunities/$(chatID.replace("^classGroup_", ""));
      return exists(communityPath) &&
        memberIDs.hasOnly(get(communityPath).data.memberIDs);
    }

    // The thread's kind is fixed by its ID, only the one campus-wide chat can
    // be public, and nobody can add themselves to a private chat.
    function isValidChatThread(chatID, data) {
      return data.memberIDs is list &&
        (
          (
            chatID == campusChatID() &&
            data.sourceKind == "campusGroup"
          ) ||
          (
            chatID != campusChatID() &&
            data.get("isCampusWide", false) == false &&
            request.auth.uid in data.memberIDs &&
            (
              (chatID.matches("directMessage_.+") && isDirectMessageBetweenFriends(data)) ||
              (
                chatID.matches("manualGroup_.+") &&
                data.sourceKind == "manualGroup" &&
                membersBelongToFriendGroup(chatID, data.memberIDs)
              ) ||
              (
                chatID.matches("classGroup_.+") &&
                data.sourceKind == "classGroup" &&
                membersBelongToCommunity(chatID, data.memberIDs)
              )
            )
          )
        );
    }

    // Only the one campus-wide thread is public. Checking the ID rather than
    // a stored flag keeps chats that were previously flagged public private.
    function isChatReadable(chatID) {
      return chatID == campusChatID() ||
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatID)).data.memberIDs;
    }

    function isValidLocationShare(ownerID) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "ownerID",
          "viewerIDs",
          "latitude",
          "longitude",
          "accuracy",
          "precision",
          "placeID",
          "placeName",
          "placeKind",
          "isOnCampus",
          "updatedAt",
          "updatedAtServer",
          "expiresAt",
          "expiresAtTimestamp",
          "source"
        ]) &&
        data.ownerID == ownerID &&
        data.viewerIDs is list &&
        data.viewerIDs.size() <= 300 &&
        !(ownerID in data.viewerIDs) &&
        data.latitude is number &&
        data.latitude >= -90 &&
        data.latitude <= 90 &&
        data.longitude is number &&
        data.longitude >= -180 &&
        data.longitude <= 180;
    }

    function isGroupMessageAlertForSharedChat(targetUserID) {
      return request.resource.data.type == "groupMessage" &&
        request.resource.data.contextID is string &&
        request.resource.data.contextID != "" &&
        exists(/databases/$(database)/documents/groupChats/$(request.resource.data.contextID)) &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(request.resource.data.contextID)).data.memberIDs &&
        targetUserID in get(/databases/$(database)/documents/groupChats/$(request.resource.data.contextID)).data.memberIDs;
    }

    match /users/{userID} {
      allow read: if signedIn();
      allow create: if isValidSelfProfileCreate(userID);
      allow update: if isValidSelfProfileUpdate(userID) || (
        isModerator() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "feedPosts",
          "lastFeedPostAt",
          "socialBanned",
          "socialMutedUntil"
        ])
      );
      allow delete: if false;

      match /deviceTokens/{installationID} {
        allow read, create, update, delete: if isSelf(userID);
      }

      match /appBackups/{backupID} {
        allow read, create, update, delete: if isSelf(userID);
      }

      // Grades, notes, tasks, and the LMS feed URL. The profile document
      // itself is readable by every signed-in user, so private state lives here.
      match /private/{documentID} {
        allow read, create, update, delete: if isSelf(userID);
      }

      match /calendarShares/{shareID} {
        allow read: if isSelf(userID);
        allow create: if signedIn() &&
          request.resource.data.ownerID == request.auth.uid &&
          areFriends(request.auth.uid, userID);
        allow update: if isSelf(userID) || (
          signedIn() &&
          resource.data.ownerID == request.auth.uid &&
          areFriends(request.auth.uid, userID)
        );
        allow delete: if isSelf(userID) || (
          signedIn() &&
          resource.data.ownerID == request.auth.uid
        );
      }

      match /socialNotifications/{notificationID} {
        allow read: if isSelf(userID);
        allow create: if signedIn() &&
          request.resource.data.senderID == request.auth.uid &&
          (
            areFriends(request.auth.uid, userID) ||
            isGroupMessageAlertForSharedChat(userID)
          );
        allow update: if isSelf(userID) || (
          signedIn() &&
          resource.data.senderID == request.auth.uid &&
          (
            areFriends(request.auth.uid, userID) ||
            (
              resource.data.type == "groupMessage" &&
              resource.data.contextID is string &&
              resource.data.contextID != "" &&
              exists(/databases/$(database)/documents/groupChats/$(resource.data.contextID)) &&
              request.auth.uid in get(/databases/$(database)/documents/groupChats/$(resource.data.contextID)).data.memberIDs &&
              userID in get(/databases/$(database)/documents/groupChats/$(resource.data.contextID)).data.memberIDs
            )
          )
        );
        allow delete: if isSelf(userID) || (
          signedIn() &&
          resource.data.senderID == request.auth.uid
        );
      }
    }

    match /friendRequests/{requestID} {
      allow read: if signedIn() &&
        (resource.data.fromUserID == request.auth.uid || resource.data.toUserID == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "fromUserID",
          "toUserID",
          "status",
          "createdAt",
          "respondedAt"
        ]) &&
        request.resource.data.fromUserID == request.auth.uid &&
        request.resource.data.toUserID is string &&
        request.resource.data.toUserID != request.auth.uid &&
        request.resource.data.status == "pending";

      allow update: if signedIn() &&
        resource.data.toUserID == request.auth.uid &&
        resource.data.status == "pending" &&
        request.resource.data.fromUserID == resource.data.fromUserID &&
        request.resource.data.toUserID == resource.data.toUserID &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ["accepted", "declined"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "respondedAt"
        ]);

      allow delete: if false;
    }

    match /friendships/{friendshipID} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isModerator() || (
        signedIn() && isAcceptedFriendship(friendshipID)
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    match /accountDeletionRequests/{userID} {
      allow create: if isSelf(userID) &&
        request.resource.data.keys().hasOnly(["requesterID", "requestedAt"]) &&
        request.resource.data.requesterID == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /friendGroups/{groupID} {
      allow read: if signedIn() && (
        resource.data.ownerID == request.auth.uid ||
        request.auth.uid in resource.data.memberIDs
      );
      allow create: if signedIn() && request.resource.data.ownerID == request.auth.uid;
      allow update: if signedIn() && (
        (
          resource.data.ownerID == request.auth.uid &&
          request.resource.data.ownerID == request.auth.uid
        ) ||
        (
          // Members may only leave; they cannot add or remove anyone else.
          request.auth.uid in resource.data.memberIDs &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIDs"]) &&
          resource.data.memberIDs.toSet().difference(request.resource.data.memberIDs.toSet()) == [request.auth.uid].toSet() &&
          request.resource.data.memberIDs.toSet().difference(resource.data.memberIDs.toSet()).size() == 0
        )
      );
      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;
    }

    match /courseCommunities/{communityID} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIDs;
      allow create: if signedIn() &&
        request.resource.data.memberIDs is list &&
        request.resource.data.memberIDs.hasOnly([request.auth.uid]) &&
        request.auth.uid in request.resource.data.memberIDs;
      // Anyone enrolled can join (add themselves) or leave (remove themselves),
      // but nobody can change another student's membership.
      allow update: if signedIn() &&
        (
          request.auth.uid in resource.data.memberIDs ||
          request.auth.uid in request.resource.data.memberIDs
        ) &&
        request.resource.data.memberIDs.toSet().difference(resource.data.memberIDs.toSet()).hasOnly([request.auth.uid]) &&
        resource.data.memberIDs.toSet().difference(request.resource.data.memberIDs.toSet()).hasOnly([request.auth.uid]);
      allow delete: if false;

      match /comments/{commentID} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/courseCommunities/$(communityID)).data.memberIDs;
        allow create: if signedIn() &&
          request.resource.data.userID == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/courseCommunities/$(communityID)).data.memberIDs;
        allow update: if signedIn() &&
          resource.data.userID == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userID == request.auth.uid ||
          isModerator()
        );
      }

      match /resources/{resourceID} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/courseCommunities/$(communityID)).data.memberIDs;
        allow create: if signedIn() &&
          request.resource.data.createdByUserID == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/courseCommunities/$(communityID)).data.memberIDs;
        allow update: if signedIn() && (
          resource.data.createdByUserID == request.auth.uid ||
          isModerator()
        );
        allow delete: if signedIn() && (
          resource.data.createdByUserID == request.auth.uid ||
          isModerator()
        );
      }
    }

    match /groupChats/{chatID} {
      allow read: if signedIn() && (
        chatID == campusChatID() ||
        request.auth.uid in resource.data.memberIDs
      );
      allow create, update: if signedIn() && isValidChatThread(chatID, request.resource.data);
      allow delete: if false;

      match /messages/{messageID} {
        allow read: if signedIn() && isChatReadable(chatID);
        allow create: if signedIn() &&
          request.resource.data.userID == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 4000 &&
          isChatReadable(chatID);
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.userID == request.auth.uid ||
          isModerator()
        );
      }

      match /polls/{pollID} {
        allow read: if signedIn() && isChatReadable(chatID);
        allow create: if signedIn() &&
          request.resource.data.createdByUserID == request.auth.uid &&
          isChatReadable(chatID);
        allow update: if signedIn() && isChatReadable(chatID) && (
          (
            // Members change only their own vote.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votesByUserID"]) &&
            request.resource.data.votesByUserID.diff(resource.data.get("votesByUserID", {}))
              .affectedKeys().hasOnly([request.auth.uid])
          ) ||
          (
            // The creator (or a moderator) can close the poll.
            (resource.data.createdByUserID == request.auth.uid || isModerator()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isClosed"])
          )
        );
        allow delete: if signedIn() && (
          resource.data.createdByUserID == request.auth.uid ||
          isModerator()
        );
      }
    }

    match /locationShares/{ownerID} {
      allow read: if isSelf(ownerID) || (
        signedIn() && request.auth.uid in resource.data.viewerIDs
      );
      allow create, update: if isSelf(ownerID) && isValidLocationShare(ownerID);
      // A viewer may remove only themselves (for example after unfriending).
      allow update: if signedIn() &&
        !isSelf(ownerID) &&
        request.auth.uid in resource.data.viewerIDs &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewerIDs"]) &&
        resource.data.viewerIDs.toSet().difference(request.resource.data.viewerIDs.toSet()).hasOnly([request.auth.uid]) &&
        request.resource.data.viewerIDs.toSet().difference(resource.data.viewerIDs.toSet()).size() == 0;
      allow delete: if isSelf(ownerID);
    }

    // One anonymous rating per student per course; everyone signed in can
    // read them to see the averages.
    match /courseRatings/{courseKey}/ratings/{userID} {
      allow read: if signedIn();
      allow create, update: if isSelf(userID) &&
        request.resource.data.keys().hasOnly(["overall", "difficulty", "hoursPerWeek", "tags", "semesterCode", "updatedAt"]) &&
        request.resource.data.overall is int &&
        request.resource.data.overall >= 1 && request.resource.data.overall <= 5 &&
        request.resource.data.difficulty is int &&
        request.resource.data.difficulty >= 1 && request.resource.data.difficulty <= 5 &&
        request.resource.data.hoursPerWeek is int &&
        request.resource.data.hoursPerWeek >= 0 && request.resource.data.hoursPerWeek <= 40 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 4 &&
        request.resource.data.semesterCode is string &&
        request.resource.data.semesterCode.size() <= 12;
      allow delete: if isSelf(userID);
    }

    // Reports of abusive content. Only moderators (via the Firebase console
    // or Admin SDK) read them.
    match /reports/{reportID} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["reporterID", "reportedUserID", "kind", "contextID", "excerpt", "reason", "createdAt"]) &&
        request.resource.data.reporterID == request.auth.uid &&
        request.resource.data.reportedUserID is string &&
        request.resource.data.reportedUserID != request.auth.uid &&
        request.resource.data.kind in ["message", "user", "plan"] &&
        request.resource.data.reason in ["spam", "harassment", "hate", "sexual", "violence", "other"] &&
        request.resource.data.excerpt is string &&
        request.resource.data.excerpt.size() <= 500;
      allow read: if isModerator();
      allow update, delete: if false;
    }

    // Invite-only spaces for a game server (or anything with an on/off
    // status). The owner invites people and sets the status; members can ask
    // for it to be started, leave, and say they're on for up to 24 hours.
    match /serverSpaces/{spaceID} {
      function spaceKeys() {
        return ["name", "address", "ownerID", "ownerName", "memberIDs", "serverOnline",
                "statusUpdatedAt", "statusUpdatedByName", "requestedByID", "requestedByName",
                "requestedAt", "createdAt"];
      }

      function validSpace(data) {
        return data.keys().hasOnly(spaceKeys()) &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 40 &&
          data.address is string && data.address.size() <= 100 &&
          data.memberIDs is list && data.memberIDs.size() <= 50 &&
          data.ownerID in data.memberIDs &&
          data.serverOnline is bool;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIDs;
      allow create: if signedIn() &&
        request.resource.data.ownerID == request.auth.uid &&
        validSpace(request.resource.data);
      allow update: if signedIn() && (
        (
          // The owner can change anything but who owns it.
          resource.data.ownerID == request.auth.uid &&
          request.resource.data.ownerID == request.auth.uid &&
          validSpace(request.resource.data)
        ) || (
          // Members can ask for the server to be started.
          request.auth.uid in resource.data.memberIDs &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["requestedByID", "requestedByName", "requestedAt"]) &&
          request.resource.data.requestedByID == request.auth.uid
        ) || (
          // Members can leave, removing only themselves.
          request.auth.uid in resource.data.memberIDs &&
          request.auth.uid != resource.data.ownerID &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIDs"]) &&
          resource.data.memberIDs.toSet().difference(request.resource.data.memberIDs.toSet()) == [request.auth.uid].toSet() &&
          request.resource.data.memberIDs.toSet().difference(resource.data.memberIDs.toSet()).size() == 0
        )
      );
      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;

      // "I'm on the server", which expires within a day.
      match /presence/{userID} {
        function space() {
          return get(/databases/$(database)/documents/serverSpaces/$(spaceID)).data;
        }

        allow read: if signedIn() && request.auth.uid in space().memberIDs;
        allow create, update: if isSelf(userID) &&
          request.auth.uid in space().memberIDs &&
          request.resource.data.keys().hasOnly(["displayName", "since", "expiresAt"]) &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 60 &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt <= request.time + duration.value(24, "h") + duration.value(5, "m");
        allow delete: if isSelf(userID) || (signedIn() && space().ownerID == request.auth.uid);
      }
    }

    match /sharedSchedules/{ownerID} {
      allow read: if isSelf(ownerID) || (
        signedIn() &&
        areFriends(request.auth.uid, ownerID) &&
        get(/databases/$(database)/documents/users/$(ownerID)).data.shareSchedule == true
      );
      allow create: if isSelf(ownerID);
      allow update: if isSelf(ownerID);
      allow delete: if isSelf(ownerID);

      match /friendViews/{viewerID} {
        allow read: if isSelf(ownerID) || (
          signedIn() &&
          request.auth.uid == viewerID &&
          areFriends(request.auth.uid, ownerID) &&
          get(/databases/$(database)/documents/users/$(ownerID)).data.shareSchedule == true
        );

        allow create: if isSelf(ownerID);
        allow update: if isSelf(ownerID);
        allow delete: if isSelf(ownerID);
      }
    }
  }
}
